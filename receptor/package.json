{
  "name": "acceso-garita-receptor",
  "version": "0.1.0",
  "description": "Receptor TCP para trackers Concox/GT06 (Jimi IoT LL301). Escucha los aparatos, decodifica el protocolo, imprime los bytes crudos en hex y guarda posiciones en Supabase.",
  "main": "index.js",
  "bin": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "test": "node test-simulador.js",
    "build:exe": "pkg . --targets node22-win-x64 --output dist/receptor-trackers.exe"
  },
  "pkg": {
    "scripts": [
      "src/**/*.js"
    ],
    "outputPath": "dist"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.21.0"
  }
}
