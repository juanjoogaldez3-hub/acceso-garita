# ============================================================================
#  CONFIGURACIÓN DEL RECEPTOR  (copiá este archivo como  .env  y llenalo)
# ============================================================================
#
#  Cómo usarlo:
#    1. Hacé una copia de este archivo y llamala   .env
#    2. Pegá las credenciales reales de Supabase (de cada ambiente).
#    3. Elegí el ambiente con SUPABASE_ENV.
#    4. NUNCA subas el archivo .env a GitHub (ya está en .gitignore).
#
# ----------------------------------------------------------------------------

# Puerto TCP donde el receptor va a escuchar a los trackers.
# El aparato LL301 se configura para apuntar a  TU_SERVIDOR:ESTE_PUERTO
TCP_PORT=5000

# ¿Qué ambiente de Supabase usar?  Opciones:  produccion   |   pruebas
# (así podés levantar el receptor apuntando a uno u otro sin tocar código)
SUPABASE_ENV=pruebas

# ----------------------------------------------------------------------------
#  Credenciales de PRODUCCIÓN
# ----------------------------------------------------------------------------
SUPABASE_URL_PROD=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY_PROD=pega_aqui_la_service_role_key_de_produccion

# ----------------------------------------------------------------------------
#  Credenciales de PRUEBAS
# ----------------------------------------------------------------------------
SUPABASE_URL_TEST=https://yyyyyyyyyyyy.supabase.co
SUPABASE_SERVICE_KEY_TEST=pega_aqui_la_service_role_key_de_pruebas

# ----------------------------------------------------------------------------
#  NOTA IMPORTANTE
# ----------------------------------------------------------------------------
#  - Usá la "service_role key" (NO la "anon key"), porque el receptor escribe
#    en la base y las tablas tienen RLS deshabilitado según tu convención.
#  - Si dejás las credenciales del ambiente elegido vacías, el receptor
#    arranca igual en "MODO DIAGNÓSTICO": solo imprime hex y responde el ACK
#    de login. Perfecto para la primera prueba de conexión del aparato.
